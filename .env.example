# ===========================================================================
# Gender Budget RAG - example environment file
#
# Copy this file to `.env` and fill in the values you need:
#     PowerShell:  Copy-Item .env.example .env
#     bash:        cp .env.example .env
#
# config.py loads `.env` automatically (via python-dotenv) at startup.
# Real OS environment variables take precedence over values in `.env`.
# Never commit the real `.env` file - it contains API keys.
# ===========================================================================


# ---------------------------------------------------------------------------
# Corpus / vector store / retrieval
# ---------------------------------------------------------------------------
# Folder containing the source documents.
RAG_CORPUS_DIR=corpus

# Persistent ChromaDB store (created by `python ingest.py`).
RAG_DB_DIR=chroma_db

# ChromaDB collection name.
RAG_COLLECTION=gender_budget

# Default number of chunks retrieved.
RAG_TOP_K=5

# Candidates pulled from the vector DB before reranking.
RAG_RERANK_POOL=60

# Cosine-distance cut-off: above this the question is reported as NOT answered.
RAG_MAX_DISTANCE=0.65

# When the UI/API asks for "all" chunks (k=0), rank the whole corpus but pass
# only this many chunks to the LLM and back to the page.
RAG_ALL_MAX_RESULTS=20


# ---------------------------------------------------------------------------
# PDF chunking (rebuild the index after changing these)
# ---------------------------------------------------------------------------
# Chunk size is in characters. 800 characters of tabular PDF text is roughly
# 320 embedding tokens, while the bundled all-MiniLM-L6-v2 model truncates at
# 256. Measure before choosing:
#     python ingest.py --dry-run
#     python ingest.py --dry-run --chunk-chars 600
RAG_PDF_CHUNK_CHARS=800
RAG_PDF_CHUNK_OVERLAP=150

# Page tails shorter than this are merged into the previous chunk.
RAG_PDF_CHUNK_MIN_CHARS=200

# Repeat the page's unit/column-header lines ("(IN THOUSANDS)", "Scheme ...")
# at the top of later chunks on the same page. Turn off to compare.
RAG_PDF_HEADER_CONTEXT=1
RAG_PDF_HEADER_CHARS=240

# Effective token limit of the embedding model; used for dry-run warnings.
RAG_EMBED_MAX_TOKENS=256


# ---------------------------------------------------------------------------
# LLM master switch
# ---------------------------------------------------------------------------
# 1 = use the configured LLM, 0 = extractive-only mode (no LLM calls).
RAG_USE_LLM=1


# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# Allowed values: local | openai | gemini
#   local  -> llama.cpp / LM Studio / Ollama (no real API key needed)
#   openai -> https://api.openai.com/v1
#   gemini -> Google AI Studio OpenAI-compatible endpoint
RAG_LLM_PROVIDER=local


# ---------------------------------------------------------------------------
# Provider API keys
# ---------------------------------------------------------------------------
# Only the key for the selected provider is required. Leave the others blank.

# Used when RAG_LLM_PROVIDER=openai
OPENAI_API_KEY=

# Used when RAG_LLM_PROVIDER=gemini (create it in Google AI Studio)
GEMINI_API_KEY=

# Alternative name for the Gemini key; either one works.
# GOOGLE_API_KEY=


# ---------------------------------------------------------------------------
# Model name
# ---------------------------------------------------------------------------
# Leave blank to use the provider default:
#   local  -> auto (ask the server which model it has)
#   openai -> gpt-4o-mini
#   gemini -> gemini-3.1-flash-lite
#
# Examples:
#   RAG_LLM_MODEL=gpt-4o
#   RAG_LLM_MODEL=gpt-4.1-mini
#   RAG_LLM_MODEL=gemini-2.5-pro
#   RAG_LLM_MODEL=gemini-2.0-flash
RAG_LLM_MODEL=


# ---------------------------------------------------------------------------
# Base URL / endpoint
# ---------------------------------------------------------------------------
# Leave blank to use the provider default:
#   local  -> http://localhost:5555/v1
#   openai -> https://api.openai.com/v1
#   gemini -> https://generativelanguage.googleapis.com/v1beta/openai/
#
# Set this for a custom OpenAI-compatible server, e.g.:
#   RAG_LLM_BASE_URL=http://localhost:1234/v1
RAG_LLM_BASE_URL=


# ---------------------------------------------------------------------------
# Explicit API key override (optional)
# ---------------------------------------------------------------------------
# Use this to override the provider-specific keys above, e.g. when pointing at
# a hosted OpenAI-compatible service. Leave blank to use OPENAI_API_KEY /
# GEMINI_API_KEY / GOOGLE_API_KEY. For local servers it defaults to `sk-local`.
RAG_LLM_API_KEY=


# ---------------------------------------------------------------------------
# Generation settings
# ---------------------------------------------------------------------------
RAG_LLM_TEMPERATURE=0.0
RAG_LLM_MAX_TOKENS=512
RAG_LLM_TIMEOUT=120
